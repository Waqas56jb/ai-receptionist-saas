PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# Public origin used in website-widget embed snippets (no trailing slash).
PUBLIC_API_URL=http://localhost:4000

# Paste these when you have them — the API starts without them and uses memory until then.
# Use the secret key on the server only. Never put it in the client or admin apps.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_DIRECT_URL=

# Used for WhatsApp voice notes and the website widget voice agent.
# Realtime speech-to-speech uses gpt-realtime via WebRTC.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Seeded on boot so these logins always work
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=admin@123!
BOOTSTRAP_ADMIN_NAME=Platform Admin
DEMO_CLIENT_EMAIL=client@gmail.com
DEMO_CLIENT_PASSWORD=client@123!
